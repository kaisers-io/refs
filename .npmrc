# Pin the public registry for this repository. A user-level default registry (a company
# mirror, for example) would otherwise decide where installs here resolve; a user-level
# `@scope:registry` still applies to its scope. pnpm 12 reads only auth, registry, TLS and
# proxy settings from this file; every other setting is in pnpm-workspace.yaml.
registry=https://registry.npmjs.org/
