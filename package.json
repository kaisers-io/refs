{
  "name": "refs-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=24.2",
    "pnpm": ">=12"
  },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages skills evals",
    "fmt:check": "oxfmt --check packages skills evals",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test:coverage",
    "versions": "node scripts/versions.mjs",
    "skill:audit": "uvx snyk-agent-scan@0.6.8 scan --skills --ci --dangerously-run-mcp-servers --ignore-risks third_party_content_exposure skills",
    "skill:eval": "scripts/skill-evals.sh",
    "skill:eval:codex": "scripts/skill-evals.sh codex",
    "refs": "pnpm --filter @kaisers-io/refs build && node packages/cli/bin/refs.mjs"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.6",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
