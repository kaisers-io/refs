{
  "name": "refs-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24.2", "pnpm": ">=11" },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages skills",
    "fmt:check": "oxfmt --check packages skills",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test",
    "versions": "node scripts/versions.mjs",
    "skill:audit": "uvx snyk-agent-scan@0.6.0 scan --skills --ci --dangerously-run-mcp-servers --ignore-risks third_party_content_exposure skills",
    "refs": "pnpm --filter @kaisers-io/refs build && node packages/cli/bin/refs.mjs"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
