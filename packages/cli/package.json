{
  "name": "@kaisers-io/refs",
  "version": "0.2.0",
  "description": "Managed read-only git checkouts of reference repositories for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisers-io/refs.git"
  },
  "bin": {
    "refs": "./bin/refs.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@kaisers-io/refs-core": "workspace:*",
    "@types/node": "24.13.2",
    "commander": "15.0.0",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.12"
  }
}
